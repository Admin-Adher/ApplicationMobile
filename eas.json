{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "preview": {
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "$EXPO_PUBLIC_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_KEY": "$EXPO_PUBLIC_SUPABASE_KEY",
        "EXPO_PUBLIC_APP_URL": "$EXPO_PUBLIC_APP_URL",
        "EXPO_PUBLIC_API_URL": "$EXPO_PUBLIC_API_URL"
      },
      "android": {
        "buildType": "apk",
        "image": "ubuntu-22.04-jdk-17-ndk-r26b"
      },
      "ios": {
        "simulator": false,
        "distribution": "internal"
      }
    },
    "simulator": {
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "$EXPO_PUBLIC_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_KEY": "$EXPO_PUBLIC_SUPABASE_KEY",
        "EXPO_PUBLIC_APP_URL": "$EXPO_PUBLIC_APP_URL",
        "EXPO_PUBLIC_API_URL": "$EXPO_PUBLIC_API_URL"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "$EXPO_PUBLIC_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_KEY": "$EXPO_PUBLIC_SUPABASE_KEY",
        "EXPO_PUBLIC_APP_URL": "$EXPO_PUBLIC_APP_URL",
        "EXPO_PUBLIC_API_URL": "$EXPO_PUBLIC_API_URL"
      },
      "android": {
        "buildType": "app-bundle",
        "image": "ubuntu-22.04-jdk-17-ndk-r26b"
      },
      "ios": {
        "distribution": "store"
      }
    }
  }
}
